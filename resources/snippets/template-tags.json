{
  "if (inline)": {
    "prefix": "dif",
    "body": "{% if ${1:condition} %}$0{% endif %}",
    "description": "Django if tag (inline)"
  },
  "if (block)": {
    "prefix": "difblock",
    "body": ["{% if ${1:condition} %}", "\t$0", "{% endif %}"],
    "description": "Django if tag (block)"
  },
  "if/else (inline)": {
    "prefix": "difelse",
    "body": "{% if ${1:condition} %}$2{% else %}$0{% endif %}",
    "description": "Django if/else tag (inline)"
  },
  "if/else (block)": {
    "prefix": "difelseblock",
    "body": [
      "{% if ${1:condition} %}",
      "\t$2",
      "{% else %}",
      "\t$0",
      "{% endif %}"
    ],
    "description": "Django if/else tag (block)"
  },
  "if/elif (block)": {
    "prefix": "difelifblock",
    "body": [
      "{% if ${1:condition} %}",
      "\t$2",
      "{% elif ${3:condition} %}",
      "\t$0",
      "{% endif %}"
    ],
    "description": "Django if/elif tag (block)"
  },
  "if/elif/else (block)": {
    "prefix": "difelifelseblock",
    "body": [
      "{% if ${1:condition} %}",
      "\t$2",
      "{% elif ${3:condition} %}",
      "\t$4",
      "{% else %}",
      "\t$0",
      "{% endif %}"
    ],
    "description": "Django if/elif/else tag (block)"
  },
  "elif": {
