    },
    {
      "do": "key",
      "key": "Home",
      "after": 400,
      "mods": ["ctrl"]
    },
    {
      "do": "key",
      "key": "Enter",
      "after": 200
    },
    {
      "do": "key",
      "key": "ArrowUp",
      "after": 250
    },
    {
      "do": "type",
      "text": "{% url '",
      "after": 1900
    },
    {
      "do": "screenshot",
      "file": "completion-url.png",
      "after": 350
