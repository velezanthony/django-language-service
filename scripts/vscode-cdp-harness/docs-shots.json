    {
      "do": "click",
      "selector": ".monaco-editor .view-lines",
      "after": 400
    },
    {
      "do": "key",
      "key": "Home",
      "after": 400,
      "mods": ["ctrl"]
    },
    {
      "do": "burst",
      "dir": "format",
      "frames": 6,
      "every": 120
    },
    {
      "do": "command",
      "title": "Format Document",
      "after": 200
    },
    {
      "do": "burst",
      "dir": "format",
      "frames": 16,
      "every": 120
    },
    {
      "do": "screenshot",
      "file": "format-after.png",
      "after": 350
    },
    {
      "do": "command",
      "title": "Focus on Views View",
      "after": 2000
    },
    {
      "do": "screenshot",
      "file": "sidebar.png",
      "after": 400
    }
  ],
  "disableExtensions": true
}
